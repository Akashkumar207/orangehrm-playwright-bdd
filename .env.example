# Copy this file to .env and adjust values for your machine.
# .env is git-ignored — never commit real secrets there.

# Overrides config/environments/*.config.ts when set. Leave unset to use TEST_ENV instead.
BASE_URL=https://opensource-demo.orangehrmlive.com

# Which environment config to use when BASE_URL is not set: dev | qa | prod
TEST_ENV=qa

# Credentials used by steps that log in without a literal value in the feature file
# (e.g. "When I login with valid credentials"). These are OrangeHRM's own published
# public demo credentials, shown directly on the login page — not a real secret.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
